{
  "name": "@eduwork/desktop-services",
  "version": "0.1.0-dev.20260910.1",
  "description": "Exposes directory picking, window attention requests and workspace access grants to DSH.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MulanPSL-2.0 AND MIT",
  "exports": {
    ".": "./lib/index.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "MARKET.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1 <0.3.0"
  },
  "keywords": [
    "desktop",
    "directory-picker",
    "attention",
    "workspace"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/schemastery": ">=3.18.0 <3.19.0",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "0.1.5-rc.2"
  }
}
